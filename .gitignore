# ---- 一次性临时内容（不入库）----
08-临时/
*.tmp
*.bak
~$*

# ---- 运行产物（一条命令可重新生成，不入库）----
# 最终交付工作簿（体积大，由求解脚本重新生成）
结果/*.xlsx
结果/*.xlsm
# 中间数据（大体积张量；小体积 CSV 证据表保留跟踪）
数据/*.npz
数据/*.npy
数据/*.h5
# 求解日志（体积可能大）
数据/*.log

# ---- 图表中间产物（矢量 PDF 保留，位图不入库）----
图表/*.png
图表/*.jpg

# ---- LaTeX 构建中间产物（main.pdf 为最终交付，保留跟踪）----
源码/*.aux
源码/*.log
源码/*.out
源码/*.toc
源码/*.fdb_latexmk
源码/*.fls
源码/*.synctex.gz
源码/*.xdv

# ---- 系统/编辑器垃圾 ----
Thumbs.db
.DS_Store
desktop.ini
*.swp

# ---- OCR 中间产物（若在仓库内）----
_mineru/

# ---- 提交/审计包（论文.zip 轻量审计包、论文/ 临时组装目录，均可重组装，不入库）----
论文/
论文.zip


# ---- 已归档的一次性 QA 产物（体积大、可由出图/编译流程再生；留档在磁盘但不入库）----
09-归档/08-临时-一次性QA/
